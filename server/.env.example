# ---- Server ----
PORT=5000

# ---- Database ----
# Leave empty to use the built-in JSON file store (server/data/db.json).
# Set to use MongoDB, e.g. mongodb://127.0.0.1:27017/velocityx-trader
MONGO_URI=

# ---- Claude AI (Anthropic) ----
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Binance ----
# Public market data works without keys.
# For LIVE trading put your keys here. Start with the testnet first!
#   Testnet keys: https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = orders go to Binance Spot Testnet (fake money). false = REAL money.
BINANCE_TESTNET=true
# Override if binance.com is blocked in your region (e.g. https://api.binance.us)
BINANCE_BASE_URL=
# Public market-data mirror used when the main endpoint fails
BINANCE_DATA_URL=https://data-api.binance.vision

# ---- Paper trading ----
PAPER_START_BALANCE=10000
# Forex (Zerodha NSE currency futures) paper wallet, in INR
PAPER_FX_START_BALANCE=1000000
# NSE stocks paper wallet, in INR
PAPER_STOCKS_START_BALANCE=1000000
# NSE options paper wallet, in INR
PAPER_OPTIONS_START_BALANCE=500000

# ---- Security ----
# 64 hex chars (openssl rand -hex 32). If empty, a key is generated in server/data/master.key - back it up!
MASTER_KEY=

# Public URL of the app (production: the https:// address)
APP_URL=http://localhost:5173

# Simulated exchange rejection rate for paper orders
PAPER_REJECT_RATE=0.002

# ---- Login (one owner/admin account from here; others can sign up, see ALLOW_SIGNUP) ----
# ADMIN_PASSWORD is applied on first start and again whenever its value here changes (restart): that is the
# offline reset. Passwords changed in the app (Account page, Forgot password via Telegram) survive restarts.
# Without ADMIN_PASSWORD, development falls back to admin / admin123. Production requires 12+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Public sign-up ("Create account" on the sign-in page). New accounts are regular users, not admins. false = owner only.
ALLOW_SIGNUP=true

# ---- Production (see .env.production.example and README "Deploying to production") ----
# NODE_ENV=production enforces MASTER_KEY, MONGO_URI, an https APP_URL and a strong ADMIN_PASSWORD.
NODE_ENV=
# Reverse proxies in front of the app (default 1 in production) - needed for real client IPs
TRUST_PROXY=
CORS_ORIGINS=
IP_RATE_LIMIT_PER_MIN=600

# NSE trading holidays (YYYY-MM-DD, comma-separated) - forex and stock bots stay idle on these days
NSE_HOLIDAYS=
