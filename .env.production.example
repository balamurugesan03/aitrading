# Production settings for docker-compose. Copy to .env.production and fill in. Never commit the real file.
# NODE_ENV, MONGO_URI and TRUST_PROXY are set by docker-compose.yml.

# ---- Domain / URLs ----
# Public hostname Caddy gets a certificate for (DNS must already point at this server)
DOMAIN=app.example.com
APP_URL=https://app.example.com
# Extra browser origins allowed to call the API, comma-separated (e.g. a separate marketing site)
CORS_ORIGINS=

# ---- Security (required) ----
# 64 hex chars: openssl rand -hex 32. Encrypts users' exchange keys and signs sessions.
# BACK IT UP somewhere safe. Losing it makes every stored exchange key unreadable and signs everyone out.
MASTER_KEY=
# The only login (no sign-up). ADMIN_PASSWORD (12+ chars) is the initial password; changing it here and restarting resets it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Per-IP request budget per minute across the API
IP_RATE_LIMIT_PER_MIN=600

# ---- Claude AI ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- Binance (optional owner keys; users connect their own in the app) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_BASE_URL=
BINANCE_DATA_URL=https://data-api.binance.vision

# ---- Paper trading ----
PAPER_START_BALANCE=10000
PAPER_FX_START_BALANCE=1000000
PAPER_REJECT_RATE=0.002
